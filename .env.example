# =====================================================================
# CHOGAN Q4 SALES SYSTEM — variables d'environnement
# Copier ce fichier en .env.local (jamais versionné) puis compléter.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur :
# n'y mettez JAMAIS de secret. Elles sont intégrées au build : relancez
# `npm run build` (ou redéployez) après modification.
# =====================================================================

# --- Site -------------------------------------------------------------
# URL publique du site (balises canoniques, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Indexation par les moteurs de recherche : laisser à false tant que les
# documents juridiques ne sont pas complétés et le site prêt.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- WhatsApp ----------------------------------------------------------
# Numéro WhatsApp professionnel, format international sans + ni espaces
# (ex. 33612345678). Vide = aucun bouton WhatsApp affiché.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Destination du bouton « Je veux rejoindre… » : form (page /inscription)
# ou whatsapp (conversation WhatsApp, nécessite le numéro ci-dessus).
NEXT_PUBLIC_REGISTRATION_MODE=form

# --- Stockage ----------------------------------------------------------
# Supabase (production). Clé SECRÈTE côté serveur uniquement :
# Supabase > Project Settings > API Keys > « secret » (sb_secret_…)
# ou, sur les anciens projets, la clé « service_role ».
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Pilote forcé (optionnel) : supabase | local
# local = fichier JSON dans LOCAL_DATA_DIR, pour le développement et les
# tests uniquement (non adapté à un hébergement serverless).
STORAGE_DRIVER=
LOCAL_DATA_DIR=.data

# --- Sécurité ----------------------------------------------------------
# Secret de signature des cookies (64 caractères aléatoires conseillés,
# 32 minimum). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Mot de passe du tableau de bord /admin (12 caractères minimum).
# Vide = administration désactivée.
ADMIN_PASSWORD=

# --- Inscriptions -------------------------------------------------------
# Interrupteur manuel : false ferme immédiatement les inscriptions.
ENROLLMENT_OPEN=true
# Date limite (ISO 8601). Vide = date définie dans src/content/offer.ts
# (5 novembre 2026, 23 h 59, heure de Paris, veille du démarrage).
ENROLLMENT_DEADLINE=

# --- Mesure et publicité (chargées UNIQUEMENT après consentement) -------
# Vide = outil désactivé. Si aucun outil n'est configuré, aucun bandeau
# cookies n'est affiché (aucun traceur non essentiel).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
